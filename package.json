{
  "name": "tilshunos-platform",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @tilshunos/api run start:dev",
    "dev:web": "npm --workspace @tilshunos/web run dev",
    "dev:mobile": "npm --workspace @tilshunos/mobile run start",
    "typecheck:mobile": "npm --workspace @tilshunos/mobile run typecheck",
    "lint:mobile": "npm --workspace @tilshunos/mobile run lint",
    "build": "npm run build --workspace @tilshunos/api && npm run build --workspace @tilshunos/web"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/mongoose": "^10.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "mongoose": "^8.9.5",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
